{
  "name": "milkup",
  "version": "0.4.12",
  "description": "A Markdown editor built with Milkdown and Vue.js",
  "keywords": [
    "Markdown",
    "markdown",
    "md",
    "milkup"
  ],
  "license": "MIT",
  "author": "Larry Zhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/auto-plugin/milkup.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "vite build && tauri build",
    "build:vite": "vite build",
    "tauri": "tauri",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxlint --fix . && oxfmt .",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm",
    "release": "genereleaselog",
    "update:deps": "npx taze -w && pnpm i"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/comment": "^0.19.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lsp-client": "^6.1.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@milkdown/core": "^7.17.1",
    "@milkdown/crepe": "^7.17.1",
    "@milkdown/exception": "^7.17.1",
    "@milkdown/kit": "^7.17.1",
    "@milkdown/plugin-automd": "^7.17.1",
    "@milkdown/plugin-diagram": "^7.7.0",
    "@milkdown/plugin-listener": "^7.17.1",
    "@milkdown/plugin-prism": "^7.17.1",
    "@milkdown/preset-commonmark": "^7.17.1",
    "@milkdown/preset-gfm": "^7.17.1",
    "@milkdown/prose": "^7.17.1",
    "@milkdown/theme-nord": "^7.17.1",
    "@milkdown/transformer": "^7.17.1",
    "@milkdown/utils": "^7.17.1",
    "@milkdown/vue": "^7.17.1",
    "@vue/runtime-dom": "^3.5.19",
    "@vueuse/core": "^14.0.0",
    "autodialog.js": "^0.0.9",
    "autotoast.js": "^3.0.3",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "codemirror-lang-mermaid": "^0.5.0",
    "docx": "^9.5.1",
    "he": "^1.2.0",
    "mdast": "^3.0.0",
    "mermaid": "^11.10.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.5",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-flexible-containers": "^1.5.0",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist": "^0.0.1",
    "unist-util-visit": "^5.0.0",
    "vditor": "^3.11.2",
    "vite-auto-i18n-plugin": "^1.1.12",
    "vue": "^3.5.19",
    "vue-color": "^3.3.1",
    "vue-draggable-plus": "^0.6.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/he": "^1.2.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "genereleaselog": "^0.0.5",
    "less": "^4.4.1",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.12.0",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,json}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "pnpm": {
    "overrides": {
      "@codemirror/state": "^6.5.2",
      "@codemirror/view": "^6.38.1",
      "@lezer/highlight": "^1.2.3",
      "@lezer/common": "^1.5.0",
      "@codemirror/language": "^6.12.1"
    },
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ],
    "patchedDependencies": {
      "@milkdown/crepe": "patches/@milkdown__crepe.patch"
    }
  }
}
